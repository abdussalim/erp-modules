{
  "name": "MiFi - Daily Overdue Rentals Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Every day 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3000/api/rentals?overdue=1",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Get Overdue Rentals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "// The API returns one item per overdue rental. Merge them into a single reminder.\nconst lines = $input.all().map((i) => {\n  const r = i.json;\n  return `- ${r.customer.name} still has ${r.device.serialNumber} (due ${r.endDate.slice(0, 10)})`;\n});\nconst message = `Overdue MiFi rentals:\n${lines.join('\n')}`;\nreturn [{ json: { message } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Build Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {},
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Show Message",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 0]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Telegram (optional)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 0],
      "disabled": true
    }
  ],
  "connections": {
    "Every day 08:00": { "main": [[{ "node": "Get Overdue Rentals", "type": "main", "index": 0 }]] },
    "Get Overdue Rentals": { "main": [[{ "node": "Build Reminder", "type": "main", "index": 0 }]] },
    "Build Reminder": { "main": [[{ "node": "Show Message", "type": "main", "index": 0 }]] },
    "Show Message": { "main": [[{ "node": "Telegram (optional)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
